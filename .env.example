# VERITAS AI - environment template. Copy to .env (never commit .env).
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   -> SECRET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(18))"   -> database password

# --- PostgreSQL container (read by docker compose) -------------------------------------------
POSTGRES_USER=veritas_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=veritas_db
# Host port. Change it (e.g. 5434) if 5432 is already used by a local PostgreSQL.
POSTGRES_PORT=5432

# --- Backend ----------------------------------------------------------------------------------
# For running the backend on your machine (not in Docker). The password and port must match the
# values above. Inside docker compose the URL is built automatically and points at the "db" service.
DATABASE_URL=postgresql+psycopg://veritas_user:CHANGE_ME@localhost:5432/veritas_db
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# Load the ML models in the background at startup (true) or on the first analysis request (false).
PRELOAD_MODELS=true
# Optional: relocate the ML files (defaults: <repo>/models and backend/ml_artifacts).
# MODELS_DIR=
# ARTIFACTS_DIR=

# --- URL analysis limits (defaults shown) -------------------------------------------------------
# URL_FETCH_TIMEOUT_SECONDS=8
# URL_MAX_BYTES=5000000
# URL_MAX_REDIRECTS=3
# URL_RATE_LIMIT_PER_MINUTE=20

# --- Addresses --------------------------------------------------------------------------------
# FRONTEND_URL is the only browser origin the API accepts (CORS).
# BACKEND_URL is informational: the browser reaches the API through the frontend's own address (nginx proxies /api/).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Host ports used by docker compose for the backend and frontend containers.
BACKEND_PORT=8000
FRONTEND_PORT=5173
