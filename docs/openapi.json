            "description": "Validation Error"
          }
        },
        "summary": "List the reference collection",
        "tags": [
          "Evidence"
        ]
      }
    },
    "/api/v1/evidence/search": {
      "get": {
        "description": "Return the reference passages that share the most vocabulary with the query (TF-IDF cosine similarity).",
        "operationId": "search_passages_api_v1_evidence_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 500,
              "minLength": 3,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "top_k",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 10,
              "minimum": 1,
              "title": "Top K",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lexical (TF-IDF) search over the reference collection",
        "tags": [
          "Evidence"
        ]
      }
    },
