{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "text": {
            "description": "Headline or article body",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Text",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional headline",
            "title": "Title"
          }
        },
        "required": [
          "text"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "properties": {
          "analysis_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Always null: this edition stores nothing (kept so responses stay compatible with the full edition)",
            "title": "Analysis Id"
          },
          "classification": {
            "$ref": "#/components/schemas/ClassificationResult"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceResult"
          },
          "linguistic_signals": {
            "items": {
              "$ref": "#/components/schemas/SignalOut"
            },
            "title": "Linguistic Signals",
            "type": "array"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the input came from a URL"
          },
          "uncertainty": {
            "$ref": "#/components/schemas/UncertaintyOut"
          },
          "word_count": {
            "title": "Word Count",
            "type": "integer"
          }
        },
        "required": [
          "word_count",
          "classification",
          "linguistic_signals",
          "evidence",
          "uncertainty",
          "disclaimer"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "ClassMetrics": {
        "properties": {
          "f1": {
            "title": "F1",
            "type": "number"
          },
          "precision": {
            "title": "Precision",
            "type": "number"
          },
          "recall": {
            "title": "Recall",
            "type": "number"
          },
          "support": {
            "title": "Support",
            "type": "integer"
          }
        },
        "required": [
          "precision",
          "recall",
          "f1",
          "support"
        ],
        "title": "ClassMetrics",
        "type": "object"
      },
      "ClassificationResult": {
        "properties": {
          "confidence_note": {
            "default": "Model confidence describes how strongly the text matches patterns in the training labels. It is not the probability that the content is true or false.",
            "title": "Confidence Note",
            "type": "string"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "kind": {
            "const": "machine_learning_classification",
            "default": "machine_learning_classification",
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "enum": [
              "resembles_unreliable_sources",
              "resembles_reliable_sources"
            ],
            "title": "Label",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "probability_unreliable_style": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability Unreliable Style",
            "type": "number"
          }
        },
        "required": [
          "label",
          "probability_unreliable_style",
          "model",
          "disclaimer"
        ],
        "title": "ClassificationResult",
        "type": "object"
      },
      "ConfusionMatrix": {
        "properties": {
          "columns_are": {
            "title": "Columns Are",
            "type": "string"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "matrix": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "title": "Matrix",
            "type": "array"
          },
          "rows_are": {
            "title": "Rows Are",
            "type": "string"
          }
        },
        "required": [
          "labels",
          "rows_are",
          "columns_are",
          "matrix"
        ],
        "title": "ConfusionMatrix",
        "type": "object"
      },
      "DomainCheck": {
        "description": "Whether the text resembles the classifier's training data.",
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "in_domain": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Domain"
          },
          "similarity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Similarity"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          }
        },
        "required": [
          "available"
        ],
        "title": "DomainCheck",
        "type": "object"
      },
      "EvidenceCollectionInfo": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "url_checked_on": {
            "title": "Url Checked On",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "size",
          "url_checked_on"
        ],
        "title": "EvidenceCollectionInfo",
        "type": "object"
      },
      "EvidenceHitOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "matched_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Text"
          },
          "passage": {
            "title": "Passage",
            "type": "string"
          },
          "relevant": {
            "title": "Relevant",
            "type": "boolean"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "source_org": {
            "title": "Source Org",
            "type": "string"
          },
          "source_title": {
            "title": "Source Title",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "topic": {
            "title": "Topic",
            "type": "string"
          }
        },
        "required": [
          "id",
          "score",
          "relevant",
          "topic",
          "passage",
          "source_org",
          "source_title",
          "source_url"
        ],
        "title": "EvidenceHitOut",
        "type": "object"
      },
      "EvidenceListResponse": {
        "properties": {
          "collection": {
            "$ref": "#/components/schemas/EvidenceCollectionInfo"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/EvidenceHitOut"
            },
            "title": "Passages",
            "type": "array"
          }
        },
        "required": [
          "collection",
          "passages"
        ],
        "title": "EvidenceListResponse",
        "type": "object"
      },
      "EvidenceResult": {
        "properties": {
          "collection_name": {
            "title": "Collection Name",
            "type": "string"
          },
          "collection_size": {
            "title": "Collection Size",
            "type": "integer"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/EvidenceHitOut"
            },
            "title": "Hits",
            "type": "array"
          },
          "kind": {
            "const": "retrieved_reference_passages",
            "default": "retrieved_reference_passages",
            "title": "Kind",
            "type": "string"
          },
          "relevance_threshold": {
            "title": "Relevance Threshold",
            "type": "number"
          },
          "retrieval_method": {
            "const": "tfidf_lexical",
            "default": "tfidf_lexical",
            "description": "Lexical TF-IDF cosine similarity: vocabulary overlap, not meaning",
            "title": "Retrieval Method",
            "type": "string"
          }
        },
        "required": [
          "collection_name",
          "collection_size",
          "relevance_threshold",
          "hits",
          "disclaimer"
        ],
        "title": "EvidenceResult",
        "type": "object"
      },
      "EvidenceSearchResponse": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/EvidenceHitOut"
            },
            "title": "Hits",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "relevance_threshold": {
            "title": "Relevance Threshold",
            "type": "number"
          },
          "retrieval_method": {
            "const": "tfidf_lexical",
            "default": "tfidf_lexical",
            "title": "Retrieval Method",
            "type": "string"
          }
        },
        "required": [
          "query",
          "relevance_threshold",
          "hits"
        ],
        "title": "EvidenceSearchResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Limitation": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "detail"
        ],
        "title": "Limitation",
        "type": "object"
      },
      "LiveHealthResponse": {
        "description": "Response payload for liveness probe.",
        "properties": {
          "application": {
            "default": "VERITAS AI",
            "description": "Application identifier",
            "title": "Application",
            "type": "string"
          },
          "status": {
            "default": "alive",
            "description": "Process liveness indicator",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LiveHealthResponse",
        "type": "object"
      },
      "MacroAverage": {
        "properties": {
          "f1": {
            "title": "F1",
            "type": "number"
          },
          "precision": {
            "title": "Precision",
            "type": "number"
          },
          "recall": {
            "title": "Recall",
            "type": "number"
          }
        },
        "required": [
          "precision",
          "recall",
          "f1"
        ],
        "title": "MacroAverage",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "test_accuracy_on_dataset_labels": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Accuracy On Dataset Labels"
          },
          "trained_on": {
            "title": "Trained On",
            "type": "string"
          }
        },
        "required": [
          "name",
          "trained_on",
          "test_accuracy_on_dataset_labels"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "PerformanceResponse": {
        "properties": {
          "cleaning": {
            "additionalProperties": true,
            "title": "Cleaning",
            "type": "object"
          },
          "dataset_license": {
            "title": "Dataset License",
            "type": "string"
          },
          "dataset_name": {
            "title": "Dataset Name",
            "type": "string"
          },
          "dataset_source": {
            "title": "Dataset Source",
            "type": "string"
          },
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "interpretation": {
            "title": "Interpretation",
            "type": "string"
          },
          "label_convention": {
            "title": "Label Convention",
            "type": "string"
          },
          "leakage_check": {
            "title": "Leakage Check",
            "type": "string"
          },
          "limitations": {
            "items": {
              "$ref": "#/components/schemas/Limitation"
            },
            "title": "Limitations",
            "type": "array"
          },
          "split_sizes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SplitSize"
            },
            "title": "Split Sizes",
            "type": "object"
          },
          "split_strategy": {
            "title": "Split Strategy",
            "type": "string"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/VariantPerformance"
            },
            "title": "Variants",
            "type": "array"
          }
        },
        "required": [
          "dataset_name",
          "dataset_source",
          "dataset_license",
          "label_convention",
          "generated_at",
          "cleaning",
          "split_strategy",
          "split_sizes",
          "leakage_check",
          "variants",
          "limitations",
          "interpretation"
        ],
        "title": "PerformanceResponse",
        "type": "object"
      },
      "ReadyHealthResponse": {
        "description": "Response payload for the readiness probe.",
        "properties": {
          "database": {
            "default": "not_used",
            "description": "This edition has no database; always 'not_used'",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "default": "ready",
            "description": "Service readiness indicator",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadyHealthResponse",
        "type": "object"
      },
      "SignalOut": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "unit",
          "description"
        ],
        "title": "SignalOut",
        "type": "object"
      },
      "SourceInfo": {
        "description": "Metadata of the fetched page. Extracted automatically and may be wrong or missing.",
        "properties": {
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "extracted_chars": {
            "title": "Extracted Chars",
            "type": "integer"
          },
          "extraction_warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the extracted text looks like a menu, feed or index page instead of one article.",
            "title": "Extraction Warning"
          },
          "final_url": {
            "title": "Final Url",
            "type": "string"
          },
          "published": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "final_url",
          "domain",
          "title",
          "author",
          "published",
          "extracted_chars",
          "truncated"
        ],
        "title": "SourceInfo",
        "type": "object"
      },
      "SplitMetrics": {
        "properties": {
          "accuracy": {
            "title": "Accuracy",
            "type": "number"
          },
          "confusion_matrix": {
            "$ref": "#/components/schemas/ConfusionMatrix"
          },
          "macro_avg": {
            "$ref": "#/components/schemas/MacroAverage"
          },
          "per_class": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ClassMetrics"
            },
            "title": "Per Class",
            "type": "object"
          }
        },
        "required": [
          "accuracy",
          "per_class",
          "macro_avg",
          "confusion_matrix"
        ],
        "title": "SplitMetrics",
        "type": "object"
      },
      "SplitSize": {
        "properties": {
          "fake": {
            "title": "Fake",
            "type": "integer"
          },
          "real": {
            "title": "Real",
            "type": "integer"
          },
          "rows": {
            "title": "Rows",
            "type": "integer"
          }
        },
        "required": [
          "rows",
          "fake",
          "real"
        ],
        "title": "SplitSize",
        "type": "object"
      },
      "SystemInfoResponse": {
        "description": "Response payload for system information.",
        "properties": {
          "application": {
            "description": "Application name",
            "title": "Application",
            "type": "string"
          },
          "docs_url": {
            "description": "Relative URL to interactive API documentation",
            "title": "Docs Url",
            "type": "string"
          },
          "environment": {
            "description": "Runtime environment",
            "title": "Environment",
            "type": "string"
          },
          "version": {
            "description": "Application version",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "application",
          "version",
          "environment",
          "docs_url"
        ],
        "title": "SystemInfoResponse",
        "type": "object"
      },
      "UncertaintyOut": {
        "properties": {
          "domain_check": {
            "$ref": "#/components/schemas/DomainCheck",
            "default": {
              "available": false
            }
          },
          "level": {
            "enum": [
              "moderate",
              "high",
              "very_high"
            ],
            "title": "Level",
            "type": "string"
          },
          "meaning": {
            "default": "This level describes how far the analysis itself can be trusted. It says nothing about whether the content is true or false, and a confident model result does not reduce it.",
            "title": "Meaning",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "standing_caveats": {
            "items": {
              "type": "string"
            },
            "title": "Standing Caveats",
            "type": "array"
          }
        },
        "required": [
          "level",
          "reasons",
          "standing_caveats"
        ],
        "title": "UncertaintyOut",
        "type": "object"
      },
      "UrlAnalysisRequest": {
        "properties": {
          "url": {
            "description": "Public http(s) URL of an article",
            "maxLength": 2048,
            "minLength": 8,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "UrlAnalysisRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VariantPerformance": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "selected_C": {
            "title": "Selected C",
            "type": "number"
          },
          "test": {
            "$ref": "#/components/schemas/SplitMetrics"
          },
          "top_features": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Top Features",
            "type": "object"
          },
          "validation": {
            "$ref": "#/components/schemas/SplitMetrics"
          },
          "variant": {
            "title": "Variant",
            "type": "string"
          },
          "vocabulary_size": {
            "title": "Vocabulary Size",
            "type": "integer"
          }
        },
        "required": [
          "variant",
          "description",
          "selected_C",
          "vocabulary_size",
          "validation",
          "test",
          "top_features"
        ],
        "title": "VariantPerformance",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A statistical text-analysis instrument. Provides a writing-style classification, linguistic indicators, lexical (TF-IDF) retrieval of related reference passages, and an uncertainty assessment. It does not verify whether content is true or false.",
    "title": "VERITAS AI",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Root redirect / welcoming payload.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "Root"
        ]
      }
    },
    "/api/v1/analysis": {
      "post": {
        "description": "Returns, as separate sections: a machine-learning style classification, linguistic signals, retrieved reference passages (lexical TF-IDF similarity) and an uncertainty assessment. It does not verify factual claims. Nothing is stored: there are no accounts and no saved analyses.",
        "operationId": "analyze_text_api_v1_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze submitted text",
        "tags": [
          "Analysis"
        ]
      }
    },
    "/api/v1/analysis/url": {
      "post": {
        "description": "Fetches a public http(s) page with SSRF protections (public addresses only, standard ports, size/time limits, revalidated redirects), extracts the article text and metadata, then runs the same analysis as POST /analysis. Extracted metadata is automatic and may be incomplete or wrong.",
        "operationId": "analyze_url_api_v1_analysis_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UrlAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Fetch an article from a URL and analyze it",
        "tags": [
          "Analysis"
        ]
      }
    },
    "/api/v1/evidence/passages": {
      "get": {
        "description": "List the reference collection, optionally filtered by topic.",
