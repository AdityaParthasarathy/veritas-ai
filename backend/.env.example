# VERITAS AI (Vercel edition): there are no required settings and no secrets. Every value below is optional.
ENVIRONMENT=development
# Load the analysis components while the app starts (blocking). Default false: they load on the first analysis request.
PRELOAD_MODELS=false
# Only needed when a browser on ANOTHER origin calls the API directly (the Vercel setup proxies /api, so it is not needed).
FRONTEND_URL=http://localhost:5173
# URL analysis limits (defaults shown)
# URL_FETCH_TIMEOUT_SECONDS=8
# URL_MAX_BYTES=5000000
# URL_MAX_REDIRECTS=3
# URL_RATE_LIMIT_PER_MINUTE=20
